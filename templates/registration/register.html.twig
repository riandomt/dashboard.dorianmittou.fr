{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="flex items-center justify-center min-h-screen">
    <twig:Card class="w-full max-w-sm">
        <twig:Card:Header>
            <twig:Card:Title>Inscription</twig:Card:Title>
            <twig:Card:Description>Saisissez vos informations personnelles</twig:Card:Description>
        </twig:Card:Header>

        {{ form_start(registrationForm) }}

        <twig:Card:Content class="flex flex-col gap-6">
            {% for flash_error in app.flashes('verify_email_error') %}
                <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
            {% endfor %}

            {{ form_errors(registrationForm) }}

            <div class="grid gap-2">
                <twig:Label :for="registrationForm.lastname.vars.id">
                    {{ registrationForm.lastname.vars.label }}
                </twig:Label>
                <twig:Input
                    id="{{ registrationForm.lastname.vars.id }}"
                    name="{{ registrationForm.lastname.vars.full_name }}"
                    type="text"
                    value="{{ registrationForm.lastname.vars.value ?? '' }}"
                    placeholder="{{ registrationForm.lastname.vars.attr.placeholder|default('') }}"
                />
                {{ form_errors(registrationForm.lastname) }}
            </div>

            <div class="grid gap-2">
                <twig:Label :for="registrationForm.firstname.vars.id">
                    {{ registrationForm.firstname.vars.label }}
                </twig:Label>
                <twig:Input
                    id="{{ registrationForm.firstname.vars.id }}"
                    name="{{ registrationForm.firstname.vars.full_name }}"
                    type="text"
                    value="{{ registrationForm.firstname.vars.value ?? '' }}"
                    placeholder="{{ registrationForm.firstname.vars.attr.placeholder|default('') }}"
                />
                {{ form_errors(registrationForm.firstname) }}
            </div>

            <div class="grid gap-2">
                <twig:Label :for="registrationForm.email.vars.id">
                    {{ registrationForm.email.vars.label }}
                </twig:Label>
                <twig:Input
                    id="{{ registrationForm.email.vars.id }}"
                    name="{{ registrationForm.email.vars.full_name }}"
                    type="email"
                    value="{{ registrationForm.email.vars.value ?? '' }}"
                    placeholder="{{ registrationForm.email.vars.attr.placeholder|default('') }}"
                />
                {{ form_errors(registrationForm.email) }}
            </div>

            <div class="grid gap-2">
                <twig:Label :for="registrationForm.roles.vars.id">
                    {{ registrationForm.roles.vars.label }}
                </twig:Label>
                <twig:Select
                    id="{{ registrationForm.roles.vars.id }}"
                    name="{{ registrationForm.roles.vars.full_name }}"
                >
                    {% if registrationForm.roles.vars.placeholder is not same as(false) %}
                        <option value="">{{ registrationForm.roles.vars.placeholder }}</option>
                    {% endif %}

                    {% for choice in registrationForm.roles.vars.choices %}
                        <option value="{{ choice.value }}" {% if choice.value == registrationForm.roles.vars.value %}selected{% endif %}>
                            {{ choice.label }}
                        </option>
                    {% endfor %}
                </twig:Select>
                {{ form_errors(registrationForm.roles) }}
            </div>

            <div class="grid gap-2">
                <twig:Label :for="registrationForm.plainPassword.vars.id">
                    {{ registrationForm.plainPassword.vars.label }}
                </twig:Label>
                <twig:Input
                    id="{{ registrationForm.plainPassword.vars.id }}"
                    name="{{ registrationForm.plainPassword.vars.full_name }}"
                    type="password"
                    value=""
                    placeholder="{{ registrationForm.plainPassword.vars.attr.placeholder|default('') }}"
                />
                {{ form_errors(registrationForm.plainPassword) }}
            </div>

            <div class="flex items-center gap-2">
                <input
                    type="checkbox"
                    id="{{ registrationForm.agreeTerms.vars.id }}"
                    name="{{ registrationForm.agreeTerms.vars.full_name }}"
                    value="1"
                    {% if registrationForm.agreeTerms.vars.checked %}checked{% endif %}
                >
                <twig:Label :for="registrationForm.agreeTerms.vars.id">
                    {{ registrationForm.agreeTerms.vars.label }}
                </twig:Label>
            </div>
            {{ form_errors(registrationForm.agreeTerms) }}

            {{ form_widget(registrationForm._token) }}
        </twig:Card:Content>

        <twig:Card:Footer>
            <twig:Button type="submit" class="w-full">
                S'inscrire
            </twig:Button>
        </twig:Card:Footer>

        {{ form_end(registrationForm, { render_rest: false }) }}
    </twig:Card>
</div>
{% endblock %}