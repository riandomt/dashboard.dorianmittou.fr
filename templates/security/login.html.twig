{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
<div class="flex items-center justify-center min-h-screen">
    <twig:Card class="w-full max-w-sm">
        <twig:Card:Header>
            <twig:Card:Title>Connexion</twig:Card:Title>
            <twig:Card:Description>Saisissez vos informations de connexion</twig:Card:Description>
        </twig:Card:Header>

        {{ form_start(registrationForm) }}

        <twig:Card:Content class="flex flex-col gap-6">
            {{ form_errors(registrationForm) }}

            <div class="grid gap-2">
                <twig:Label :for="registrationForm.email.vars.id">
                    {{ registrationForm.email.vars.label }}
                </twig:Label>
                <twig:Input id="{{ registrationForm.lastname.vars.id }}"
                    name="{{ registrationForm.lastname.vars.full_name }}" type="text"
                    value="{{ registrationForm.lastname.vars.value ?? '' }}"
                    placeholder="{{ registrationForm.lastname.vars.attr.placeholder|default('') }}" />
                {{ form_errors(registrationForm.lastname) }}
            </div>

            {{ form_widget(registrationForm._token) }}
        </twig:Card:Content>

        <twig:Card:Footer>
            <twig:Button type="submit" class="w-full">
                Se connecter
            </twig:Button>
        </twig:Card:Footer>

        {{ form_end(registrationForm, { render_rest: false }) }}
    </twig:Card>
</div>

<form method="post">
    {% if error %}
    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    {% if app.user %}
    <div class="mb-3">
        You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
    </div>
    {% endif %}

    <h1 class="h3 mb-3 font-weight-normal">Please sign in</h1>
    <label for="username">Email</label>
    <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control"
        autocomplete="email" required autofocus>
    <label for="password">Password</label>
    <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

    {#
    Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
    See https://symfony.com/doc/current/security/remember_me.html

    <div class="checkbox mb-3">
        <input type="checkbox" name="_remember_me" id="_remember_me">
        <label for="_remember_me">Remember me</label>
    </div>
    #}

    <button class="btn btn-lg btn-primary" type="submit">
        Sign in
    </button>
</form>
{% endblock %}